# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/tijori

# AI (required for dispute resolution)
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-1.5-flash-latest

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated, default: *)
ALLOWED_ORIGINS=*

# Seeding (set to "true" to enable POST /api/dev/seed)
ALLOW_SEED=false